[Unit]
Description=Recover the USB XSDL tablet panel for KlipperScreen
After=systemd-udevd.service KlipperScreen.service
Wants=KlipperScreen.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tablet-usb-watchdog.sh
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
